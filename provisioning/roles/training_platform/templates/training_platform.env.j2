# Managed by Ansible (training_platform role)
# Environment variables for subcase_1b/training_platform integration
# LTI_TOOL_PRIVATE_KEY: PEM private key or path to private key used for LTI launches.
LTI_TOOL_PRIVATE_KEY={{ training_platform_lti_tool_private_key | quote }}
# OPENEDX_URL: Base URL for Open edX (e.g., https://openedx.example.org).
OPENEDX_URL={{ training_platform_openedx_url | quote }}
# OPENEDX_API_TOKEN: API token for Open edX integration.
OPENEDX_API_TOKEN={{ training_platform_openedx_api_token | quote }}
# OPENEDX_SESSION_COOKIE: Session cookie fallback when API token is not used.
OPENEDX_SESSION_COOKIE={{ training_platform_openedx_session_cookie | quote }}
# MISP_URL: Base URL for MISP integration.
MISP_URL={{ training_platform_misp_url | quote }}
# MISP_API_KEY: API key for MISP.
MISP_API_KEY={{ training_platform_misp_api_key | quote }}
# KYPO_URL: Base URL for KYPO environment.
KYPO_URL={{ training_platform_kypo_url | quote }}
# LTI_CLIENT_ID: LTI client ID configured in LMS.
LTI_CLIENT_ID={{ training_platform_lti_client_id | quote }}
# LTI_DEPLOYMENT_ID: LTI deployment ID configured in LMS.
LTI_DEPLOYMENT_ID={{ training_platform_lti_deployment_id | quote }}
